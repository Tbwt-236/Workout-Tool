{
  "name": "fitquest-mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
